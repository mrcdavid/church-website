# Copy to backend/.env for local development. Never commit the real .env file.

# development | production. Production turns on HSTS, turns off /docs, and
# requires DATABASE_URL and ALLOWED_HOSTS.
ENVIRONMENT=development

# Leave empty in development to use a local SQLite file (backend/dev.db).
# Production example: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Required for creating/editing/deleting events. Leave empty to keep the API
# read-only. Must be 32+ random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_TOKEN=

# Websites allowed to call the API from a browser (exact origins, comma-separated).
ALLOWED_ORIGINS=http://localhost:5173

# Domain names this API answers to (comma-separated). Blocks spoofed Host headers.
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional tuning (defaults shown)
# ENABLE_DOCS=true
# MAX_BODY_BYTES=16384
# RATE_LIMIT_PER_MINUTE=120
# WRITE_RATE_LIMIT_PER_MINUTE=10
